# Docker Compose is bound to loopback and uses a disposable local-development password.
# Copy to .env to customize. Set an actual secret using a secret store for deployment.
POSTGRES_PASSWORD=orbital_local_only
WEB_PORT=8088
# 0 imports all valid objects from the configured groups; e.g. 500 caps each import.
CELESTRAK_MAX_OBJECTS=0
# Optional Kafka-driven trajectory cache; keep false for on-demand full-catalog visualization.
PRECOMPUTE_TRAJECTORIES=false
# Production full-catalog screening budget (minutes); local development keeps 15.
CONJUNCTION_MAX_SCAN_MINUTES=60

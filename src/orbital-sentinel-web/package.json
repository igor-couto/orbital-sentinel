{
  "name": "orbital-sentinel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-cesium.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-cesium.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json package.json index.html README.md",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json index.html README.md"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "cesium": "1.146.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
